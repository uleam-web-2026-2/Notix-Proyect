meta {
  name: 4 Cambio colaborador 403
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/tareas/{{taskId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{collaboratorToken}}
}

body:json {
  {
    "estado": "en_proceso"
  }
}

tests {
  test("El colaborador no autorizado recibe 403", function() {
    expect(res.status).to.equal(403);
  });
}
